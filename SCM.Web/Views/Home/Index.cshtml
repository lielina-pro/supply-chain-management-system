@model DashboardViewModel
@{
    ViewData["Title"] = "Operations Overview";
}

<div class="scm-page-header">
    <div>
        <div class="scm-eyebrow">Control tower</div>
        <h1>Operations overview</h1>
    </div>
    <div class="scm-page-actions">
        <a class="scm-btn-ghost" asp-controller="PurchaseOrder" asp-action="Index">View reports</a>
        <a class="scm-btn" asp-controller="PurchaseOrder" asp-action="Create">+ New purchase order</a>
    </div>
</div>

<div class="scm-dashboard-grid">
    <div class="scm-hero-card">
        <div class="scm-eyebrow">Fulfillment health</div>
        <div class="scm-hero-metric">@Model.FulfillmentRate%</div>
        <p class="scm-hero-sub">Orders fully delivered vs. total issued</p>
        <span class="scm-hero-pill">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m18 15-6-6-6 6"/></svg>
            @Model.DeliveredOrders of @Model.TotalPurchaseOrders delivered
        </span>
        <div class="scm-hero-stats">
            <div>
                <div class="scm-hero-stat-label">Open POs</div>
                <div class="scm-hero-stat-value">@Model.OpenPurchaseOrders</div>
            </div>
            <div>
                <div class="scm-hero-stat-label">Active suppliers</div>
                <div class="scm-hero-stat-value">@Model.ActiveSuppliers</div>
            </div>
            <div>
                <div class="scm-hero-stat-label">In transit</div>
                <div class="scm-hero-stat-value">@Model.SentOrders</div>
            </div>
        </div>
    </div>

    <div class="scm-metric-card">
        <div class="scm-eyebrow">Open POs</div>
        <div class="scm-metric-value">@Model.OpenPurchaseOrders</div>
        <div class="scm-metric-delta scm-metric-delta--info">@Model.DraftOrders draft · @Model.SentOrders sent</div>
    </div>

    <div class="scm-metric-card">
        <div class="scm-eyebrow">Suppliers</div>
        <div class="scm-metric-value">@Model.TotalSuppliers</div>
        <div class="scm-metric-delta scm-metric-delta--up">@Model.ActiveSuppliers active</div>
    </div>
</div>

<div class="scm-dashboard-row">
    <div class="scm-metric-card">
        <div class="scm-eyebrow">Draft orders</div>
        <div class="scm-metric-value">@Model.DraftOrders</div>
        <div class="scm-metric-delta scm-metric-delta--warn">Awaiting dispatch</div>
    </div>
    <div class="scm-metric-card">
        <div class="scm-eyebrow">Partial receipts</div>
        <div class="scm-metric-value">@Model.PartiallyDelivered</div>
        <div class="scm-metric-delta scm-metric-delta--warn">Needs receiving</div>
    </div>
    <div class="scm-metric-card">
        <div class="scm-eyebrow">Delivered</div>
        <div class="scm-metric-value">@Model.DeliveredOrders</div>
        <div class="scm-metric-delta scm-metric-delta--up">Closed this period</div>
    </div>
</div>

<div class="scm-dashboard-bottom">
    <div class="scm-panel">
        <div class="scm-panel-header">
            <h2>Inventory movement</h2>
            <span class="scm-tag scm-tag--info">Live</span>
        </div>
        <div class="scm-chart-placeholder" aria-hidden="true">
            @for (var i = 0; i < 12; i++)
            {
                var h = 30 + (i * 7 % 70);
                <div class="scm-chart-bar @(i == 10 ? "scm-chart-bar--active" : "")" style="height:@(h)%"></div>
            }
        </div>
    </div>

    <div class="scm-panel">
        <div class="scm-panel-header">
            <h2>Alerts</h2>
            @if (Model.Alerts.Count(a => a.Severity is "danger" or "warning") > 0)
            {
                <span class="scm-tag scm-tag--danger">@Model.Alerts.Count(a => a.Severity is "danger" or "warning") critical</span>
            }
        </div>
        <div class="scm-alert-list">
            @foreach (var alert in Model.Alerts)
            {
                <div class="scm-alert-item">
                    <div class="scm-alert-icon scm-alert-icon--@alert.Severity">
                        @if (alert.Severity == "danger")
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4M12 17h.01"/></svg>
                        }
                        else if (alert.Severity == "warning")
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
                        }
                    </div>
                    <div class="scm-alert-body">
                        @if (alert.LinkUrl is not null)
                        {
                            <p class="scm-alert-title"><a href="@alert.LinkUrl">@alert.Title</a></p>
                        }
                        else
                        {
                            <p class="scm-alert-title">@alert.Title</p>
                        }
                        <p class="scm-alert-desc">@alert.Description</p>
                    </div>
                    <span class="scm-tag scm-tag--@alert.Severity">@alert.Severity</span>
                </div>
            }
        </div>
    </div>
</div>

@if (Model.RecentOrders.Any())
{
    <div class="scm-panel" style="margin-top:1.1rem;">
        <div class="scm-panel-header">
            <h2>Recent purchase orders</h2>
            <a class="scm-panel-link" asp-controller="PurchaseOrder" asp-action="Index">View all →</a>
        </div>
        <div class="scm-card" style="box-shadow:none;border:none;">
            <table class="scm-table">
                <thead>
                    <tr>
                        <th>PO #</th>
                        <th>Supplier</th>
                        <th>Status</th>
                        <th>Order date</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var o in Model.RecentOrders)
                {
                    <tr>
                        <td class="scm-mono-cell">#@o.Id</td>
                        <td>@o.SupplierCompanyName</td>
                        <td><span class="scm-tag scm-tag-@(o.StatusName.ToLower())">@o.StatusName</span></td>
                        <td class="scm-mono-cell">@o.OrderDate.ToString("yyyy-MM-dd")</td>
                        <td><a asp-controller="PurchaseOrder" asp-action="Details" asp-route-id="@o.Id">View</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
