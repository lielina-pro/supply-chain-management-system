@model DashboardViewModel
@{
    ViewData["Title"] = "Operations Overview";
    var isEmpty = Model.TotalPurchaseOrders == 0;
    var attentionCount = Model.Alerts.Count(a => a.Severity is "danger" or "warning");
    var rate = (double)Model.FulfillmentRate;
    const double Circ = 263.89;
    var dashOffset = Circ - (Circ * Math.Clamp(rate, 0, 100) / 100.0);
}

<div class="scm-page-header">
    <div>
        <p class="scm-eyebrow">Control tower</p>
        <h1>Operations overview</h1>
    </div>
    <div class="scm-page-actions">
        <a class="scm-btn" asp-controller="PurchaseOrder" asp-action="Create">+ New purchase order</a>
    </div>
</div>

<div class="scm-dashboard-layout">
    <div class="scm-dashboard-primary">
        @if (isEmpty)
        {
            <div class="scm-empty-state">
                <div class="scm-empty-state-mark" aria-hidden="true">
                    <svg viewBox="0 0 48 48" fill="none">
                        <rect x="8" y="14" width="32" height="24" rx="3" stroke="currentColor" stroke-width="2"/>
                        <path d="M16 14V11a8 8 0 0 1 16 0v3" stroke="currentColor" stroke-width="2"/>
                        <path d="M20 26h8M24 22v8" stroke="currentColor" stroke-width="2" stroke-linecap="square"/>
                    </svg>
                </div>
                <h2 class="scm-empty-state-title">No purchase orders yet</h2>
                <p class="scm-empty-state-copy">
                </p>
                <div class="scm-page-actions">
                    <a class="scm-btn" asp-controller="PurchaseOrder" asp-action="Create">Create purchase order</a>
                    <a class="scm-btn scm-btn-secondary" asp-controller="Supplier" asp-action="Index">View suppliers</a>
                </div>
            </div>
        }
        else
        {
            <div class="scm-hero-card">
                <div class="scm-hero-gauge" aria-hidden="true">
                    <svg viewBox="0 0 100 100" class="scm-gauge-svg">
                        <circle class="scm-gauge-track" cx="50" cy="50" r="42" />
                        <circle class="scm-gauge-fill" cx="50" cy="50" r="42"
                                stroke-dasharray="@Circ.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                stroke-dashoffset="@dashOffset.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                    </svg>
                    <div class="scm-gauge-center">
                        <span class="scm-gauge-value">@Model.FulfillmentRate%</span>
                        <span class="scm-gauge-label">delivered</span>
                    </div>
                </div>

                <div class="scm-hero-body">
                    <h2 class="scm-hero-title">Fulfillment health</h2>
                    <p class="scm-hero-sub">
                        @Model.DeliveredOrders of @Model.TotalPurchaseOrders orders fully received
                    </p>
                    <div class="scm-hero-stats">
                        <div>
                            <div class="scm-hero-stat-value">@Model.OpenPurchaseOrders</div>
                            <div class="scm-hero-stat-label">Open POs</div>
                        </div>
                        <div>
                            <div class="scm-hero-stat-value">@Model.ActiveSuppliers</div>
                            <div class="scm-hero-stat-label">Active suppliers</div>
                        </div>
                        <div>
                            <div class="scm-hero-stat-value">@Model.SentOrders</div>
                            <div class="scm-hero-stat-label">In transit</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="scm-pipeline">
                <div class="scm-pipeline-item">
                    <span class="scm-pipeline-value">@Model.DraftOrders</span>
                    <span class="scm-pipeline-label">Draft</span>
                    <span class="scm-pipeline-hint">Awaiting dispatch</span>
                </div>
                <div class="scm-pipeline-item">
                    <span class="scm-pipeline-value">@Model.SentOrders</span>
                    <span class="scm-pipeline-label">In transit</span>
                    <span class="scm-pipeline-hint">Sent to supplier</span>
                </div>
                <div class="scm-pipeline-item">
                    <span class="scm-pipeline-value">@Model.PartiallyDelivered</span>
                    <span class="scm-pipeline-label">Partial receipts</span>
                    <span class="scm-pipeline-hint">Needs receiving</span>
                </div>
                <div class="scm-pipeline-item">
                    <span class="scm-pipeline-value">@Model.DeliveredOrders</span>
                    <span class="scm-pipeline-label">Delivered</span>
                    <span class="scm-pipeline-hint">Closed</span>
                </div>
            </div>

            @if (Model.RecentOrders.Any())
            {
                <div class="scm-panel" style="margin-top:1.1rem;">
                    <div class="scm-panel-header">
                        <h2>Recent purchase orders</h2>
                        <a class="scm-panel-link" asp-controller="PurchaseOrder" asp-action="Index">View all</a>
                    </div>
                    <table class="scm-table scm-table--flush">
                        <thead>
                            <tr>
                                <th>PO</th>
                                <th>Supplier</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var o in Model.RecentOrders)
                        {
                            <tr>
                                <td class="scm-mono-cell"><a asp-controller="PurchaseOrder" asp-action="Details" asp-route-id="@o.Id">#@o.Id</a></td>
                                <td>@o.SupplierCompanyName</td>
                                <td><span class="scm-tag scm-tag-@(o.StatusName.ToLower())">@o.StatusName</span></td>
                                <td class="scm-mono-cell">@o.OrderDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>

    <aside class="scm-dashboard-aside">
        <div class="scm-panel">
            <div class="scm-panel-header">
                <h2>Quick stats</h2>
            </div>
            <dl class="scm-quick-stats">
                <div class="scm-quick-stat">
                    <dt>Suppliers</dt>
                    <dd>@Model.TotalSuppliers <span class="scm-quick-stat-meta"> </span></dd>
                </div>
                <div class="scm-quick-stat">
                    <dt>Purchase orders</dt>
                    <dd>@Model.TotalPurchaseOrders</dd>
                </div>
                <div class="scm-quick-stat">
                    <dt>Open</dt>
                    <dd>@Model.OpenPurchaseOrders</dd>
                </div>
                <div class="scm-quick-stat">
                    <dt>Delivered</dt>
                    <dd>@Model.DeliveredOrders</dd>
                </div>
            </dl>
        </div>

        <div class="scm-panel">
            <div class="scm-panel-header">
                <h2>Alerts</h2>
                @if (attentionCount > 0)
                {
                    <span class="scm-tag scm-tag--danger">@attentionCount attention</span>
                }
                else
                {
                    <span class="scm-tag scm-tag--info">Clear</span>
                }
            </div>
            <div class="scm-alert-list">
                @foreach (var alert in Model.Alerts)
                {
                    <div class="scm-alert-item">
                        <div class="scm-alert-icon scm-alert-icon--@alert.Severity" title="@alert.Severity" aria-hidden="true">
                            @if (alert.Severity == "danger")
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square"><path d="M12 4 3 20h18L12 4z"/><path d="M12 10v4M12 17h.01"/></svg>
                            }
                            else if (alert.Severity == "warning")
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
                            }
                        </div>
                        <div class="scm-alert-body">
                            @if (alert.LinkUrl is not null)
                            {
                                <p class="scm-alert-title"><a href="@alert.LinkUrl">@alert.Title</a></p>
                            }
                            else
                            {
                                <p class="scm-alert-title">@alert.Title</p>
                            }
                            <p class="scm-alert-desc">@alert.Description</p>
                        </div>
                        <span class="scm-tag scm-tag--@alert.Severity">@alert.Severity</span>
                    </div>
                }
            </div>
        </div>
    </aside>
</div>
