@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool NavActive(string c, string? a = null) =>
        controller.Equals(c, StringComparison.OrdinalIgnoreCase) &&
        (a is null || action.Equals(a, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]  </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="scm-shell">
        <aside class="scm-rail">
            <a class="scm-brand" asp-controller="Home" asp-action="Index">
                <span class="scm-brand-mark"></span>
                
            </a>
            <nav class="scm-rail-nav">
                <div class="scm-rail-section-label">Operations</div>
                <a asp-controller="Home" asp-action="Index" class="@(NavActive("Home") ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"/></svg>
                    Dashboard
                </a>
                <a asp-controller="PurchaseOrder" asp-action="Index" class="@(NavActive("PurchaseOrder", "Index") || NavActive("PurchaseOrder", "Details") ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"><path d="M8 4h11v16H8z"/><path d="M5 7h3M5 12h3M5 17h3"/><path d="M12 10h4M12 14h4"/></svg>
                    Purchase orders
                </a>
                <a asp-controller="PurchaseOrder" asp-action="Create" class="@(NavActive("PurchaseOrder", "Create") ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square"><path d="M12 5v14M5 12h14"/></svg>
                    New purchase order
                </a>

                <div class="scm-rail-section-label">System</div>
                <a asp-controller="Supplier" asp-action="Index" class="@(NavActive("Supplier", "Index") || NavActive("Supplier", "Details") || NavActive("Supplier", "Edit") ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"><path d="M4 8h16v12H4z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
                    Suppliers
                </a>
                <a asp-controller="Supplier" asp-action="Register" class="@(NavActive("Supplier", "Register") ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"><circle cx="10" cy="8" r="3.5"/><path d="M4 19c0-3 2.5-5 6-5s6 2 6 5"/><path d="M18 8v5M15.5 10.5h5"/></svg>
                    Register supplier
                </a>
            </nav>
        </aside>

        <div class="scm-workspace">
            <header class="scm-header">
                <div class="scm-search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    <input type="search" placeholder="Search suppliers, orders, SKUs…" aria-label="Search" />
                </div>
                <div class="scm-header-actions">
                    <button type="button" class="scm-header-btn" aria-label="Notifications">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"><path d="M6 17h12l-1.5-2.5V10a4.5 4.5 0 0 0-9 0v4.5L6 17z"/><path d="M10 17a2 2 0 0 0 4 0"/></svg>
                    </button>
                    <div class="scm-avatar" aria-hidden="true">OP</div>
                </div>
            </header>

            <main class="scm-main">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="scm-alert scm-alert-success">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="scm-alert scm-alert-error">@TempData["ErrorMessage"]</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
</body>
</html>
