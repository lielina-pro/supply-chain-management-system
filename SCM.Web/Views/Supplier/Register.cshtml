@model SupplierRegisterViewModel
@{
    ViewData["Title"] = "Register Supplier";
}

<div class="scm-page-header">
    <div>
        <div class="scm-eyebrow">System</div>
        <h1>Register supplier</h1>
    </div>
</div>

<form asp-action="Register" method="post" class="scm-form">
    <div asp-validation-summary="ModelOnly" class="scm-alert scm-alert-error"></div>

    <fieldset>
        <legend>Account</legend>
        <div class="scm-field">
            <label asp-for="FullName"></label>
            <input asp-for="FullName" />
            <span asp-validation-for="FullName" class="scm-field-error"></span>
        </div>
        <div class="scm-field">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" />
            <span asp-validation-for="Email" class="scm-field-error"></span>
        </div>
        <div class="scm-field">
            <label asp-for="Password"></label>
            <input asp-for="Password" type="password" />
            <span asp-validation-for="Password" class="scm-field-error"></span>
        </div>
        <div class="scm-field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" type="password" />
            <span asp-validation-for="ConfirmPassword" class="scm-field-error"></span>
        </div>
        <div class="scm-field">
            <label asp-for="PhoneNumber"></label>
            <input asp-for="PhoneNumber" />
        </div>
    </fieldset>

    <fieldset>
        <legend>Company profile</legend>
        <div class="scm-field">
            <label asp-for="CompanyName"></label>
            <input asp-for="CompanyName" />
            <span asp-validation-for="CompanyName" class="scm-field-error"></span>
        </div>
        <div class="scm-field">
            <label asp-for="ContactEmail"></label>
            <input asp-for="ContactEmail" type="email" />
            <span asp-validation-for="ContactEmail" class="scm-field-error"></span>
        </div>
        <div class="scm-field">
            <label asp-for="ContactPhone"></label>
            <input asp-for="ContactPhone" />
        </div>
        <div class="scm-field">
            <label asp-for="Address"></label>
            <input asp-for="Address" />
        </div>
        <div class="scm-field">
            <label asp-for="TaxIdentificationNumber"></label>
            <input asp-for="TaxIdentificationNumber" />
        </div>
        <div class="scm-field">
            <label asp-for="BusinessLicenseNumber"></label>
            <input asp-for="BusinessLicenseNumber" />
        </div>
    </fieldset>

    <div><button type="submit" class="scm-btn">Register</button></div>
</form>
