@model SupplierEditViewModel
@{
    ViewData["Title"] = "Edit Supplier Profile";
}

<div class="scm-eyebrow">welcome</div>
<h1>Edit Supplier Profile</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="scm-form">
    <div asp-validation-summary="ModelOnly" class="scm-alert scm-alert-error"></div>
    <input type="hidden" asp-for="Id" />

    <fieldset>
        <legend>Company profile</legend>
        <div class="scm-field">
            <label asp-for="CompanyName"></label>
            <input asp-for="CompanyName" />
            <span asp-validation-for="CompanyName" class="scm-field-error"></span>
        </div>
        <div class="scm-field">
            <label asp-for="ContactEmail"></label>
            <input asp-for="ContactEmail" type="email" />
            <span asp-validation-for="ContactEmail" class="scm-field-error"></span>
        </div>
        <div class="scm-field">
            <label asp-for="ContactPhone"></label>
            <input asp-for="ContactPhone" />
        </div>
        <div class="scm-field">
            <label asp-for="Address"></label>
            <input asp-for="Address" />
        </div>
        <div class="scm-field">
            <label asp-for="TaxIdentificationNumber"></label>
            <input asp-for="TaxIdentificationNumber" />
        </div>
        <div class="scm-field">
            <label asp-for="BusinessLicenseNumber"></label>
            <input asp-for="BusinessLicenseNumber" />
        </div>
    </fieldset>

    <div style="display:flex; gap:0.75rem;">
        <button type="submit" class="scm-btn">Save changes</button>
        <a class="scm-btn scm-btn-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
    </div>
</form>
